, Noto Sans;position: relative;white-space: nowrap\" title=\"jai\">在<rt style=\"font-size: 60%;position: absolute;top: -1.2em;left: 0.4em\">재-</rt></ruby><ruby style=\"font-family:Sans-serif, Noto Sans;position: relative;white-space: nowrap\" title=\"sīm-lāi\">心內<rt style=\"font-size: 60%;position: absolute;top: -1.2em;left: 0.55em\">심ˉ래ˉ</rt></ruby>\n  </span>\n  <span style=\"display: block;font-size: 0.7em;color: gray;margin-top: -5px;font-family: Calibri\">\n    gùn e-yêng-oân-khǹg-jai-sīm-lāi\n  </span>\n</p>\n<br>\n\n\n\n<table class=\"wp-block-table alignleft\" style=\"border-collapse: collapse;border: none;font-size: 16px\">\n  <tbody><tr>\n    <td style=\"border: none;vertical-align: top;min-width: 5em;padding-right: 1.5em;padding-left: 0;padding-top: 0;padding-bottom: 0\">\n  <a href=\"#_ftnref1\" id=\"_ftn1\">¹</a>\n  <i>\n    <span style=\"font-family:Sans-serif, Noto Sans\"><ruby style=\"font-family:Sans-serif, Noto Sans;position: relative;white-space: nowrap\">車輦<rt style=\"font-size: 60%;position: absolute;top: -1.3em;left: 0.85em\">챠ˉ롄`</rt></ruby></span>\n  </i> :\n</td>\n    <td style=\"border: none;padding: 0\">\n      (中) 車輪。<br>\n      (en) Wheels.\n    </td>\n  </tr>\n</tbody></table>\n\n<div style=\"clear: both;margin-bottom: 1em\"></div>\n"
