  "body": "<h2 class=\"wp-block-heading\"><span style=\"font-family:Sans-serif, Noto Sans TC\"><ruby class=\"tli-reading-ruby\" title=\"bang\">望<rt class=\"tli-rt\">빵-</rt></ruby><ruby class=\"tli-reading-ruby\" title=\"chūn\">春<rt class=\"tli-rt\">춘ˉ-</rt></ruby><ruby class=\"tli-reading-ruby\" title=\"hông\">風<rt class=\"tli-rt\">헝ˆ</rt></ruby></span></h2>\n\n\n<figure class=\"wp-block-embed is-type-video is-provider-youtube wp-block-embed-youtube wp-embed-aspect-16-9 wp-has-aspect-ratio\"><div class=\"wp-block-embed__wrapper\">\n<span class=\"embed-youtube\" style=\"text-align:center; display: block;\"><iframe loading=\"lazy\" class=\"youtube-player\" width=\"640\" height=\"360\" src=\"https://www.youtube.com/embed/QjyGy5LdWB4?version=3&amp;rel=1&amp;showsearch=0&amp;showinfo=1&amp;iv_load_policy=1&amp;fs=1&amp;hl=en&amp;autohide=2&amp;wmode=transparent\" allowfullscreen=\"true\" style=\"border:0;\" sandbox=\"allow-scripts allow-same-origin allow-popups allow-presentation allow-popups-to-escape-sandbox\"></iframe></span>\n</div></figure>\n\n\n<h3 class=\"wp-block-heading\">漢諺混寫 Hanri-Hangul mixed script</h3>\n\n\n<p>\n  <span class=\"lyric-line\">\n    <ruby class=\"tli-reading-ruby\">獨夜<rt class=\"tli-rt\">덕야ˉ</rt></ruby> <ruby class=\"tli-reading-ruby\">無<rt class=\"tli-rt\">뽀-</rt></ruby><ruby class=\"tli-reading-ruby\">伴<rt class=\"tli-rt\">퐐ˉ</rt></ruby> <ruby class=\"tli-reading-ruby\">守<rt class=\"tli-rt\">쥬ˉ-</rt></ruby><span style=\"text-indent:0;display:inline-block\"><ruby class=\"tli-reading-ruby\">燈下<rt class=\"tli-rt\">뎽ˉ에ˉ</rt></ruby>,</span> <ruby class=\"tli-reading-ruby\">清風<rt class=\"tli-rt\">촁ˉ헝ˆ</rt></ruby> <ruby class=\"tli-reading-ruby\">對<rt class=\"tli-rt\">뒤ˋ</rt></ruby><ruby class=\"tli-reading-ruby\">面<rt class=\"tli-rt\">삔-</rt></ruby><ruby class=\"tli-reading-ruby\">吹<rt class=\"tli-rt\">체ˆ</rt></ruby>\n  </span>\n  <span class=\"lyric-lomari\">\n    tork-yā bo-phoā̰ jiū-tiēng-ē, chiēng-hông tùi-bin-chê\n  </span>\n</p>\n\n\n<p>\n  <span class=\"lyric-line\">\n    <ruby class=\"tli-reading-ruby\">十<rt class=\"tli-rt\">잡ˆ-</rt></ruby><ruby class=\"tli-reading-ruby\">七<rt class=\"tli-rt\">칟-</rt></ruby><ruby class=\"tli-reading-ruby\">八<rt class=\"tli-rt\">뵣</rt></ruby> <ruby class=\"tli-reading-ruby\">未<rt class=\"tli-rt\">뻬-</rt></ruby><span style=\"text-indent:0;display:inline-block\"><ruby class=\"tli-reading-ruby\">出嫁<rt class=\"tli-rt\">춛ˆ게</rt></ruby>,</span> <ruby class=\"tli-reading-ruby\">見<rt class=\"tli-rt\">길ˆ-</rt></ruby><ruby class=\"tli-reading-ruby\">著<rt class=\"tli-rt\">둏ˆ-</rt></ruby><ruby class=\"tli-reading-ruby\">少年家<rt class=\"tli-rt\">ᄉᆤˋ롄게ˆ</rt></ruby>\n  </span>\n  <span class=\"lyric-lomari\">\n    jâp-chit-poeh be-chût-ke, kḭ̂-tiôh-siàu-lien-kê\n  </span>\n</p>\n\n\n<p>\n  <span class=\"lyric-line\">\n    <ruby class=\"tli-reading-ruby\">果然<rt class=\"tli-rt\">고ˆ뗸-</rt></ruby><ruby class=\"tli-reading-ruby\">漂緻<rt class=\"tli-rt\">ᄇᆤˉ디</rt></ruby> <ruby class=\"tli-reading-ruby\">面肉<rt class=\"tli-rt\">삔빻</rt></ruby> <span style=\"text-indent:0;display:inline-block\"><ruby class=\"tli-reading-ruby\">白<rt class=\"tli-rt\">벻ˆ</rt></ruby>,</span> <ruby class=\"tli-reading-ruby\">誰<rt class=\"tli-rt\">쉬-</rt></ruby><ruby class=\"tli-reading-ruby\">家<rt class=\"tli-rt\">게ˆ</rt></ruby> <ruby class=\"tli-reading-ruby\">人子弟<rt class=\"tli-rt\">랑즈ˆ데ˉ</rt></ruby>\n  </span>\n  <span class=\"lyric-lomari\">\n    kô-rien-piāu-ti bin-bah pêh, sui-kê lang-ĵ-tē\n  </span>\n</p>\n\n\n<p>\n  <span class=\"lyric-line\">\n    <ruby class=\"tli-reading-ruby\">想欲<rt class=\"tli-rt\">슐뾯-</rt></ruby><ruby class=\"tli-reading-ruby\">問<rt class=\"tli-rt\">믕-</rt></ruby><ruby>이<rt>ˍ</rt></ruby> <ruby class=\"tli-reading-ruby\">驚<rt class=\"tli-rt\">걀-</rt></ruby><span style=\"text-indent:0;display:inline-block\"><ruby class=\"tli-reading-ruby\">歹勢<rt class=\"tli-rt\">패ˆ세</rt></ruby>,</span> <ruby class=\"tli-reading-ruby\">心內<rt class=\"tli-rt\">심ˉ래ˉ</rt></ruby> <ruby class=\"tli-reading-ruby\">彈<rt class=\"tli-rt\">돨-</rt></ruby><ruby class=\"tli-reading-ruby\">琵琶<rt class=\"tli-rt\">비베ˊ</rt></ruby>\n  </span>\n  <span class=\"lyric-lomari\">\n    siṵ-boeh-mng-ī kia̰-phâi-se, sīm-lāi toa̰-pi-pé\n  </span>\n</p>\n\n\n<br>\n\n\n<p>\n  <span class=\"lyric-line\">\n    <ruby class=\"tli-reading-ruby\">想欲<rt class=\"tli-rt\">슐뾯-</rt></ruby><ruby class=\"tli-reading-ruby\">良君<rt class=\"tli-rt\">령군ˆ</rt></ruby> <ruby class=\"tli-reading-ruby\">做<rt class=\"tli-rt\">조ˆ-</rt></ruby><span style=\"text-indent:0;display:inline-block\"><ruby class=\"tli-reading-ruby\">翁婿<rt class=\"tli-rt\">앙ˉ새</rt></ruby>,</span> <ruby class=\"tli-reading-ruby\">意愛<rt class=\"tli-rt\">이ˋ애</rt></ruby> <ruby class=\"tli-reading-ruby\">在<rt class=\"tli-rt\">재-</rt></ruby><ruby class=\"tli-reading-ruby\">心內<rt class=\"tli-rt\">심ˉ래ˉ</rt></ruby>\n  </span>\n  <span class=\"lyric-lomari\">\n    siṵ-boeh-liong-kûn jô-āng-sai, ì-ai jai-sīm-lāi\n  </span>\n</p>\n\n\n<p>\n  <span class=\"lyric-line\">\n    <ruby class=\"tli-reading-ruby\">待<rt class=\"tli-rt\">태-</rt></ruby><ruby class=\"tli-reading-ruby\">何時<rt class=\"tli-rt\">호시ˊ</rt></ruby> <ruby class=\"tli-reading-ruby\">君<rt class=\"tli-rt\">군ˆ</rt></ruby> <ruby class=\"tli-reading-ruby\">來<rt class=\"tli-rt\">래-</rt></ruby><span style=\"text-indent:0;display:inline-block\"><ruby class=\"tli-reading-ruby\">採<rt class=\"tli-rt\">채ˋ</rt></ruby>,</span> <ruby class=\"tli-reading-ruby\">青春<rt class=\"tli-rt\">촁ˉ춘ˆ</rt></ruby> <ruby class=\"tli-reading-ruby\">花<rt class=\"tli-rt\">훼ˆ</rt></ruby> <ruby class=\"tli-reading-ruby\">當開<rt class=\"tli-rt\">등ˉ캐ˆ</rt></ruby>\n  </span>\n  <span class=\"lyric-lomari\">\n    thai-ho-sí kûn lai-chài, chiēng-chûn huê tn̄g-khâi\n  </span>\n</p>\n\n\n<p>\n  <span class=\"lyric-line\">\n    <ruby class=\"tli-reading-ruby\">忽<rt class=\"tli-rt\">훋-</rt></ruby><ruby class=\"tli-reading-ruby\">聽<rt class=\"tli-rt\">턀-</rt></ruby><ruby class=\"tli-reading-ruby\">外口<rt class=\"tli-rt\">꽈ᄏᅷˋ</rt></ruby> <ruby class=\"tli-reading-ruby\">有<rt class=\"tli-rt\">우-</rt></ruby><ruby class=\"tli-reading-ruby\">人<rt class=\"tli-rt\">랑-</rt></ruby><span style=\"text-indent:0;display:inline-block\"><ruby class=\"tli-reading-ruby\">來<rt class=\"tli-rt\">래ˊ</rt></ruby>,</span> <ruby class=\"tli-reading-ruby\">開門<rt class=\"tli-rt\">퀴ˉ믕ˊ</rt></ruby> 가<ruby>이<rt>ˍ</rt></ruby> <ruby class=\"tli-reading-ruby\">看覓<rt class=\"tli-rt\">콸ˋ매ˉ</rt></ruby>\n  </span>\n  <span class=\"lyric-lomari\">\n    hut-thia̰-goa-khàu u-lang-lái, khūi-mńg ka-ī khoà̰-māi\n  </span>\n</p>\n\n\n<p>\n  <span class=\"lyric-line\">\n    <ruby class=\"tli-reading-ruby\">月老<rt class=\"tli-rt\">꽏로ˋ</rt></ruby> <ruby class=\"tli-reading-ruby\">笑<rt class=\"tli-rt\">쵸ˆ-</rt></ruby><ruby>꾼<rt>ˎ</rt></ruby> <ruby class=\"tli-reading-ruby\">慐<rt class=\"tli-rt\">껑-</rt></ruby><ruby class=\"tli-reading-ruby\">大<rt class=\"tli-rt\">돠-</rt></ruby><span style=\"text-indent:0;display:inline-block\"><ruby class=\"tli-reading-ruby\">呆<rt class=\"tli-rt\">대ˆ</rt></ruby>,</span> <ruby class=\"tli-reading-ruby\">予<rt class=\"tli-rt\">허-</rt></ruby><ruby class=\"tli-reading-ruby\">風<rt class=\"tli-rt\">헝-</rt></ruby><ruby class=\"tli-reading-ruby\">騙<rt class=\"tli-rt\">폔</rt></ruby> <ruby class=\"tli-reading-ruby\">毋<rt class=\"tli-rt\">음-</rt></ruby><ruby class=\"tli-reading-ruby\">知<rt class=\"tli-rt\">재ˆ</rt></ruby>\n  </span>\n  <span class=\"lyric-lomari\">\n    goat-lò chiô-gùn gong-toa-tâi, hor-hong-phien m-jâi\n  </span>\n</p>\n",
