  "body": "\n<figure class=\"wp-block-embed is-type-video is-provider-youtube wp-block-embed-youtube wp-embed-aspect-4-3 wp-has-aspect-ratio\"><div class=\"wp-block-embed__wrapper\">\n<span class=\"embed-youtube\" style=\"text-align:center; display: block;\"><iframe loading=\"lazy\" class=\"youtube-player\" width=\"640\" height=\"360\" src=\"https://www.youtube.com/embed/6MclX9ZhyUw?version=3&amp;rel=1&amp;showsearch=0&amp;showinfo=1&amp;iv_load_policy=1&amp;fs=1&amp;hl=en&amp;autohide=2&amp;wmode=transparent\" allowfullscreen=\"true\" style=\"border:0;\" sandbox=\"allow-scripts allow-same-origin allow-popups allow-presentation allow-popups-to-escape-sandbox\"></iframe></span>\n</div></figure>\n\n\n\n<h3 class=\"wp-block-heading\">漢諺混寫 Hanri-Hangul mixed script</h3>\n\n\n\n\n<p style=\"font-family:Sans-serif, Noto Sans\">\n  <span style=\"display: block;font-size: 1em\">\n    <ruby style=\"position: relative;white-space: nowrap\">天色<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.55em\">틸ˉ셱</rt></ruby> <ruby style=\"position: relative;white-space: nowrap\">烏陰<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.55em\">어ˉ임ˆ</rt></ruby>\n  </span>\n  <span style=\"display: block;font-size: 0.7em;color: gray;margin-top: -5px;font-family: Calibri\">\n    thḭ̄-siek ōr-îm\n  </span>\n</p>\n\n\n<p style=\"font-family:Sans-serif, Noto Sans\">\n  <span style=\"display: block;font-size: 1em\">\n    <ruby style=\"position: relative;white-space: nowrap\">強<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.4em\">경-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">欲<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.05em\">뼇ˆ-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">喘<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.05em\">촨ˆ-</rt></ruby>뾔<ruby style=\"position: relative;white-space: nowrap\">過<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.05em\">궤`-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">氣<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.4em\">키</rt></ruby>\n  </span>\n  <span style=\"display: block;font-size: 0.7em;color: gray;margin-top: -5px;font-family: Calibri\">\n    kiong-bêh-choân-boe-kuè-khi\n  </span>\n</p>\n\n\n<p style=\"font-family:Sans-serif, Noto Sans\">\n  <span style=\"display: block;font-size: 1em\">\n    <ruby style=\"position: relative;white-space: nowrap\">驚惶<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.55em\">걀ˉ햘ˊ</rt></ruby> <ruby style=\"position: relative;white-space: nowrap\">孤單<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.55em\">거ˉ돨ˆ</rt></ruby>\n  </span>\n  <span style=\"display: block;font-size: 0.7em;color: gray;margin-top: -5px;font-family: Calibri\">\n    kiā̰-hiá̰ kōr-toâ̰\n  </span>\n</p>\n\n\n<p style=\"font-family:Sans-serif, Noto Sans\">\n  <span style=\"display: block;font-size: 1em\">\n    <ruby style=\"position: relative;white-space: nowrap\">奮鬥<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.55em\">훈`ᄃᅷ`-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">佇<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.4em\">듸-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\" title=\"jît\">這<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.05em\">짇ˆ-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">款<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.25em\">콴`</rt></ruby> <ruby style=\"position: relative;white-space: nowrap\">生活<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.55em\">솅ˉ왛ˆ</rt></ruby>\n  </span>\n  <span style=\"display: block;font-size: 0.7em;color: gray;margin-top: -5px;font-family: Calibri\">\n    hùn-tàu-ti-jît-khoàn siēng-oâh\n  </span>\n</p>\n\n\n<p style=\"font-family:Sans-serif, Noto Sans\">\n  <span style=\"display: block;font-size: 1em\">\n    <ruby style=\"position: relative;white-space: nowrap\">身軀<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.55em\">신ˉ쿠ˆ</rt></ruby> <ruby style=\"position: relative;white-space: nowrap\">拍拚<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.55em\">팧ˆ뱔</rt></ruby>’에 <ruby style=\"position: relative;white-space: nowrap\">傷痕<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.55em\">셩ˉ훈ˊ</rt></ruby>\n  </span>\n  <span style=\"display: block;font-size: 0.7em;color: gray;margin-top: -5px;font-family: Calibri\">\n    sīn-khû phâh-pia̰’e siōng-hún\n  </span>\n</p>\n\n\n<p style=\"font-family:Sans-serif, Noto Sans\">\n  <span style=\"display: block;font-size: 1em\">\n    <span style=\"font-family:Sans-serif, Noto Sans TC\"><ruby style=\"position: relative\">헤<rt style=\"font-size: 120%;position: absolute;top: -1.15em;left: 0.2em;z-index: -1\">ˎ</rt></ruby> 됴<ruby style=\"position: relative;white-space: nowrap\">是<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.4em\">시-</rt></ruby><ruby style=\"position: relative\">꽈<rt style=\"font-size: 120%;position: absolute;top: -1.15em;left: 0.2em;z-index: -1\">ˎ</rt></ruby>’에 <ruby style=\"position: relative;white-space: nowrap\">青春<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.55em\">촁ˉ춘ˆ</rt></ruby>\n  </span>\n  <span style=\"display: block;font-size: 0.7em;color: gray;margin-top: -5px;font-family: Calibri\">\n    hê tio-si-goà’e chiēng-chûn\n  </span>\n</span></p>\n<br>\n\n\n\n\n<p style=\"font-family:Sans-serif, Noto Sans\">\n  <span style=\"display: block;font-size: 1em\">\n    <ruby style=\"position: relative;white-space: nowrap\">煩惱<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.8em\">환로`</rt></ruby> <ruby style=\"position: relative;white-space: nowrap\">憂傷<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.55em\">유ˉ셩ˆ</rt></ruby>\n  </span>\n  <span style=\"display: block;font-size: 0.7em;color: gray;margin-top: -5px;font-family: Calibri\">\n    hoan-lò yū-siông\n  </span>\n</p>\n\n\n<p style=\"font-family:Sans-serif, Noto Sans\">\n  <span style=\"display: block;font-size: 1em\">\n    <ruby style=\"position: relative;white-space: nowrap\">凡事<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.8em\">환수ˉ</rt></ruby> <ruby style=\"position: relative;white-space: nowrap\">攏<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.05em\">렁ˆ-</rt></ruby>뽀<ruby style=\"position: relative;white-space: nowrap\">定著<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.8em\">댤둏ˆ</rt></ruby>\n  </span>\n  <span style=\"display: block;font-size: 0.7em;color: gray;margin-top: -5px;font-family: Calibri\">\n    hoan-sū lông-bo-tia̰-tiôh\n  </span>\n</p>\n\n\n<p style=\"font-family:Sans-serif, Noto Sans\">\n  <span style=\"display: block;font-size: 1em\">\n    <ruby style=\"position: relative;white-space: nowrap\">彷徨<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.8em\">벙헝ˊ</rt></ruby> <ruby style=\"position: relative;white-space: nowrap\">艱苦<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.55em\">간ˉ커`</rt></ruby>\n  </span>\n  <span style=\"display: block;font-size: 0.7em;color: gray;margin-top: -5px;font-family: Calibri\">\n    pong-hóng kān-khòr\n  </span>\n</p>\n\n\n<p style=\"font-family:Sans-serif, Noto Sans\">\n  <span style=\"display: block;font-size: 1em\">\n    가<ruby style=\"position: relative;white-space: nowrap\">當做<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.55em\">덩ˉ죄`-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">普通<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.55em\">퍼ˆ텅ˉ-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">平常<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.8em\">볭셩ˊ</rt></ruby>\n  </span>\n  <span style=\"display: block;font-size: 0.7em;color: gray;margin-top: -5px;font-family: Calibri\">\n    ka̰-tōng-joè-phôr-thōng-pieng-sióng\n  </span>\n</p>\n\n\n<p style=\"font-family:Sans-serif, Noto Sans\">\n  <span style=\"display: block;font-size: 1em\">\n    <ruby style=\"position: relative;white-space: nowrap\">跤踏實地<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 1em\">카ˉ닿싣데ˉ</rt></ruby>’에 <ruby style=\"position: relative;white-space: nowrap\">人<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.25em\">랑ˊ</rt></ruby>\n  </span>\n  <span style=\"display: block;font-size: 0.7em;color: gray;margin-top: -5px;font-family: Calibri\">\n    khā-tah-sit-tē’e láng\n  </span>\n</p>\n\n\n<p style=\"font-family:Sans-serif, Noto Sans\">\n  <span style=\"display: block;font-size: 1em\">\n    <ruby style=\"position: relative\">란<rt style=\"font-size: 120%;position: absolute;top: -1.15em;left: 0.2em;z-index: -1\">ˎ</rt></ruby> <ruby style=\"position: relative;white-space: nowrap\">為<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.4em\">위-</rt></ruby>둏<ruby style=\"position: relative;white-space: nowrap\">未來<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.8em\">삐래ˊ</rt></ruby> <ruby style=\"position: relative;white-space: nowrap\">做夢<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.55em\">죄`빵ˉ</rt></ruby>\n  </span>\n  <span style=\"display: block;font-size: 0.7em;color: gray;margin-top: -5px;font-family: Calibri\">\n    làn wi-tioh-bi-lái joè-bāng\n  </span>\n</p>\n<br>\n\n\n\n<p style=\"font-family:Sans-serif\">\n    <span style=\"display: block;font-size: 1em\">\n        你有我 我有你\n    </span>\n    <span style=\"display: block;font-size: 0.7em;color: gray;margin-top: -5px;font-family: Calibri\">\n        nǐ yǒu wǒ wǒ yǒu nǐ\n    </span>\n</p>\n\n<p style=\"font-family:Sans-serif\">\n    <span style=\"display: block;font-size: 1em\">\n        我們一起\n    </span>\n    <span style=\"display: block;font-size: 0.7em;color: gray;margin-top: -5px;font-family: Calibri\">\n        wǒ men yī qǐ\n    </span>\n</p>\n\n<p style=\"font-family:Sans-serif\">\n    <span style=\"display: block;font-size: 1em\">\n        勇敢地 相信著\n    </span>\n    <span style=\"display: block;font-size: 0.7em;color: gray;margin-top: -5px;font-family: Calibri\">\n        yǒng gǎn de xiāng xìn zhe\n    </span>\n</p>\n\n<p style=\"font-family:Sans-serif\">\n    <span style=\"display: block;font-size: 1em\">\n        不畏挫折\n    </span>\n    <span style=\"display: block;font-size: 0.7em;color: gray;margin-top: -5px;font-family: Calibri\">\n        bù wèi cuò zhé\n    </span>\n</p>\n\n<p style=\"font-family:Sans-serif\">\n    <span style=\"display: block;font-size: 1em\">\n        我們把自己拯救\n    </span>\n    <span style=\"display: block;font-size: 0.7em;color: gray;margin-top: -5px;font-family: Calibri\">\n        wǒ men bǎ zì jǐ zhěng jiù\n    </span>\n</p>\n\n<p style=\"font-family:Sans-serif\">\n    <span style=\"display: block;font-size: 1em\">\n        彼此扶持邁進不曾停留\n    </span>\n    <span style=\"display: block;font-size: 0.7em;color: gray;margin-top: -5px;font-family: Calibri\">\n        bǐ cǐ fú chí mài jìn bù céng tíng liú\n    </span>\n</p>\n<br>\n\n\n\n<p style=\"font-family:Sans-serif\">\n    <span style=\"display: block;font-size: 1em\">\n        傻了嗎 衝了嗎\n    </span>\n    <span style=\"display: block;font-size: 0.7em;color: gray;margin-top: -5px;font-family: Calibri\">\n        shǎ le ma chōng le ma\n    </span>\n</p>\n\n<p style=\"font-family:Sans-serif\">\n    <span style=\"display: block;font-size: 1em\">\n        準備出發\n    </span>\n    <span style=\"display: block;font-size: 0.7em;color: gray;margin-top: -5px;font-family: Calibri\">\n        zhǔn bèi chū fā\n    </span>\n</p>\n\n<p style=\"font-family:Sans-serif\">\n    <span style=\"display: block;font-size: 1em\">\n        不害怕 更揮灑\n    </span>\n    <span style=\"display: block;font-size: 0.7em;color: gray;margin-top: -5px;font-family: Calibri\">\n        bù hài pà gèng huī sǎ\n    </span>\n</p>\n\n<p style=\"font-family:Sans-serif\">\n    <span style=\"display: block;font-size: 1em\">\n        在眼淚中遠望\n    </span>\n    <span style=\"display: block;font-size: 0.7em;color: gray;margin-top: -5px;font-family: Calibri\">\n        zài yǎn lèi zhōng yuǎn wàng\n    </span>\n</p>\n\n<p style=\"font-family:Sans-serif\">\n    <span style=\"display: block;font-size: 1em\">\n        我們曾走過的地方\n    </span>\n    <span style=\"display: block;font-size: 0.7em;color: gray;margin-top: -5px;font-family: Calibri\">\n        wǒ men céng zǒu guò de dì fāng\n    </span>\n</p>\n<br>\n\n\n\n\n<p style=\"font-family:Sans-serif, Noto Sans\">\n  <span style=\"display: block;font-size: 1em\">\n    <ruby style=\"position: relative\">란<rt style=\"font-size: 120%;position: absolute;top: -1.15em;left: 0.2em;z-index: -1\">ˎ</rt></ruby> <ruby style=\"position: relative;white-space: nowrap\">相信<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.55em\">셩ˉ신</rt></ruby>’됴\n  </span>\n  <span style=\"display: block;font-size: 0.7em;color: gray;margin-top: -5px;font-family: Calibri\">\n    làn siōng-sin’tio\n  </span>\n</p>\n\n\n<p style=\"font-family:Sans-serif, Noto Sans\">\n  <span style=\"display: block;font-size: 1em\">\n    <ruby style=\"position: relative;white-space: nowrap\">一枝<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.8em\">짇기ˉ-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">草<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.25em\">ᄎᅷ`</rt></ruby> 우<ruby style=\"position: relative;white-space: nowrap\">一點<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.8em\">짇댬ˆ-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">露<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.25em\">러ˉ</rt></ruby>\n  </span>\n  <span style=\"display: block;font-size: 0.7em;color: gray;margin-top: -5px;font-family: Calibri\">\n    jit-kī-chàu u-jit-tiâm-lōr\n  </span>\n</p>\n\n\n<p style=\"font-family:Sans-serif, Noto Sans\">\n  <span style=\"display: block;font-size: 1em\">\n    <ruby style=\"position: relative\">란<rt style=\"font-size: 120%;position: absolute;top: -1.15em;left: 0.2em;z-index: -1\">ˎ</rt></ruby> <ruby style=\"position: relative;white-space: nowrap\">行<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.4em\">걀-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">過<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.05em\">궤`-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">人生<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.8em\">띤솅ˆ</rt></ruby> <ruby style=\"position: relative;white-space: nowrap\">陣陣<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.8em\">준준ˉ</rt></ruby>’에 <ruby style=\"position: relative;white-space: nowrap\">風雨<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.55em\">헝ˉ허ˉ</rt></ruby>\n  </span>\n  <span style=\"display: block;font-size: 0.7em;color: gray;margin-top: -5px;font-family: Calibri\">\n    làn kia̰-kuè-rin-siêng jun-jūn’e hōng-hōr\n  </span>\n</p>\n\n\n<p style=\"font-family:Sans-serif, Noto Sans\">\n  <span style=\"display: block;font-size: 1em\">\n    <ruby style=\"position: relative;white-space: nowrap\">憑<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.4em\">빈-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">一寡<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.8em\">짇과ˆ-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">勇氣<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.55em\">영ˆ키</rt></ruby> <ruby style=\"position: relative;white-space: nowrap\">使然<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.55em\">수ˆ뗸ˊ</rt></ruby>’에 <ruby style=\"position: relative;white-space: nowrap\">粗魯<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.55em\">처ˉ러`</rt></ruby>\n  </span>\n  <span style=\"display: block;font-