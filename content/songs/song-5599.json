-index: -1\">ꞈ</rt></ruby>뽀<ruby style=\"position: relative;white-space: nowrap\">情<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.25em\">졩ˊ</rt></ruby>’에 <ruby style=\"position: relative;white-space: nowrap\">心<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.25em\">심ˆ</rt></ruby>\n  </span>\n  <span style=\"display: block;font-size: 0.7em;color: gray;margin-top: -5px;font-family: Calibri\">\n    chīm-chîm’e ai, oa̰-lî-bo-jiéng’e sîm\n  </span>\n</p>\n\n\n<p style=\"font-family:Sans-serif, Noto Sans\">\n  <span style=\"display: block;font-size: 1em\">\n    <ruby style=\"position: relative\">제<rt style=\"font-size: 120%;position: absolute;top: -1.15em;left: 0.2em;z-index: -1\">ˎ</rt></ruby> <ruby style=\"position: relative\">감<rt style=\"font-size: 120%;position: absolute;top: -1.15em;left: 0.2em;z-index: -1\">ꞈ</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">是<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.4em\">시-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">男人<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.8em\">람띤ˊ</rt></ruby> <ruby style=\"position: relative;white-space: nowrap\">痴情<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.55em\">치ˉ졩ˊ</rt></ruby> <ruby style=\"position: relative;white-space: nowrap\">命運<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.8em\">먀운ˉ</rt></ruby>\n  </span>\n  <span style=\"display: block;font-size: 0.7em;color: gray;margin-top: -5px;font-family: Calibri\">\n    jê kâm-si-lam-rín chī-jiéng mia-ūn\n  </span>\n</p>\n\n\n<p style=\"font-family:Sans-serif, Noto Sans\">\n  <span style=\"display: block;font-size: 1em\">\n    <ruby style=\"position: relative;white-space: nowrap\">昔日<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.55em\">셱ˆ띧ˆ</rt></ruby>’에 <ruby style=\"position: relative;white-space: nowrap\">恩愛<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.55em\">운ˉ애</rt></ruby> <ruby style=\"position: relative;white-space: nowrap\">情份<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.8em\">졩훈ˉ</rt></ruby>\n  </span>\n  <span style=\"display: block;font-size: 0.7em;color: gray;margin-top: -5px;font-family: Calibri\">\n    siêk-rît’e ūn-ai jieng-hūn\n  </span>\n</p>\n\n\n<p style=\"font-family:Sans-serif, Noto Sans\">\n  <span style=\"display: block;font-size: 1em\">\n    <ruby style=\"position: relative;white-space: nowrap\">到<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.05em\">ᄀᅷ`-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">如今<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.8em\">뚜김ˆ</rt></ruby> <ruby style=\"position: relative;white-space: nowrap\">變成<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.8em\">볜솅-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">傷痕<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.55em\">셩ˉ훈ˊ</rt></ruby>\n  </span>\n  <span style=\"display: block;font-size: 0.7em;color: gray;margin-top: -5px;font-family: Calibri\">\n    kàu-ru-kîm pien-sieng-siōng-hún\n  </span>\n</p>\n<br>\n\n\n\n\n<p style=\"font-family:Sans-serif, Noto Sans\">\n  <span style=\"display: block;font-size: 1em\">\n    <ruby style=\"position: relative;white-space: nowrap\">心<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.05em\">심ˉ-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">路<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.25em\">러ˉ</rt></ruby> 야<span style=\"text-indent:0;display:inline-block\"><ruby style=\"position: relative;white-space: nowrap\">長<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.25em\">등ˊ</rt></ruby>,</span> <ruby style=\"position: relative;white-space: nowrap\">情<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.4em\">졩-</rt></ruby><ruby style=\"position: relative;white-space: