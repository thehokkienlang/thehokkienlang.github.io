index: -1\">ˍ</rt></ruby> <ruby style=\"position: relative;white-space: nowrap\">定定<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.8em\">댤댤-</rt></ruby>가<ruby style=\"position: relative\">꾼<rt style=\"font-size: 120%;position: absolute;top: -1.15em;left: 0.2em;z-index: -1\">ꞈ</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">講<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.25em\">겅`</rt></ruby>\n  </span>\n  <span style=\"display: block;font-size: 0.7em;color: gray;margin-top: -5px;font-family: Calibri\">\n    ī tia̰-tia̰-ka̰-gûn-kòng\n  </span>\n</p>\n\n\n<p style=\"font-family:Sans-serif, Noto Sans\">\n  <span style=\"display: block;font-size: 1em\">\n    <ruby style=\"position: relative;white-space: nowrap\">叫<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.05em\">교`-</rt></ruby><ruby style=\"position: relative\">꾼<rt style=\"font-size: 120%;position: absolute;top: -1.15em;left: 0.2em;z-index: -1\">ˎ</rt></ruby> 됴<ruby style=\"position: relative\">애<rt style=\"font-size: 120%;position: absolute;top: -1.15em;left: 0.2em;z-index: -1\">ˎ</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">好好<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.55em\">호ˆ호ˆ-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">仔<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.05em\">아ˆ-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">讀冊<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.8em\">탁쳏</rt></ruby>\n  </span>\n  <span style=\"display: block;font-size: 0.7em;color: gray;margin-top: -5px;font-family: Calibri\">\n    kiò-gùn tio-ài-hô-hô-â-thak-cheh\n  </span>\n</p>\n\n\n<p style=\"font-family:Sans-serif, Noto Sans\">\n  <span style=\"display: block;font-size: 1em\">\n    음<ruby style=\"position: relative;white-space: nowrap\">通<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.05em\">탕ˉ-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">大漢<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.8em\">돠한</rt></ruby> <ruby style=\"position: relative;white-space: nowrap\">像<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.4em\">츌-</rt></ruby><ruby style=\"position: relative\">린<rt style=\"font-size: 120%;position: absolute;top: -1.15em;left: 0.2em;z-index: -1\">ꞈ</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">老爸<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.8em\">ᄅᅷ베-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">仔<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.25em\">아`</rt></ruby> <ruby style=\"position: relative;white-space: nowrap\">遐邇<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.55em\">햫ˆ니-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">仔<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.05em\">아ˆ-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">狼狽<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.8em\">령붸ˉ</rt></ruby>’엏\n  </span>\n  <span style=\"display: block;font-size: 0.7em;color: gray;margin-top: -5px;font-family: Calibri\">\n    m-thāng-toa-han chiṵ-lîn-lau-pe-à hiâh-ni-â-liong-puē’orh\n  </span>\n</p>\n<br>\n\n\n\n\n<p style=\"font-family:Sans-serif, Noto Sans\">\n  <span style=\"display: block;font-size: 1em\">\n    <ruby style=\"position: relative;white-space: nowrap\">佇<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.4em\">듸-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\" title=\"hît\">彼<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.05em\">힏ˆ-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">个<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.4em\">에-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">時陣<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.8em\">시준ˉ</rt></ruby> <ruby style=\"position: relative\">꾼<rt style=\"font-size: 120%;position: absolute;top: -1.15em;left: 0.2em;z-index: -1\">ˎ</rt></ruby> <ruby style=\"position: relative;white-space: nowrap\">攏<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.05em\">렁ˆ-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">聽<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.05em\">턀ˉ-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">攏<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.05em\">렁ˆ-</rt></ruby><ruby style=\"position: relative\">뽀<rt style=\"font-size: 120%;position: absolute;top: -1.15em;left: 0.2em;z-index: -1\">ˏ</rt></ruby>\n  </span>\n  <span style=\"display: block;font-size: 0.7em;color: gray;margin-top: -5px;font-family: Calibri\">\n    ti-hît-e-si-jūn gùn lông-thiā̰-lông-bó\n  </span>\n</p>\n\n\n<p style=\"font-family:Sans-serif, Noto Sans\">\n  <span style=\"display: block;font-size: 1em\">\n    <ruby style=\"position: relative;white-space: nowrap\">阿媽<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.55em\">아ˉ마`</rt></ruby>\n  </span>\n  <span style=\"display: block;font-size: 0.7em;color: gray;margin-top: -5px;font-family: Calibri\">\n    ā-mà\n  </span>\n</p>\n\n\n<p style=\"font-family:Sans-serif, Noto Sans\">\n  <span style=\"display: block;font-size: 1em\">\n    <ruby style=\"position: relative\">릐<rt style=\"font-size: 120%;position: absolute;top: -1.15em;left: 0.2em;z-index: -1\">ˎ</rt></ruby> <ruby style=\"position: relative;white-space: nowrap\">到底<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.55em\">ᄃᅷ`되`</rt></ruby> <ruby style=\"position: relative;white-space: nowrap\">是<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.4em\">시-</rt></ruby><ruby style=\"position: relative\">렣<rt style=\"font-size: 120%;position: absolute;top: -1.15em;left: 0.2em;z-index: -1\">ꞈ</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">講<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.05em\">겅ˆ-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">啥貨<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.55em\">샬ˆ훼</rt></ruby>\n  </span>\n  <span style=\"display: block;font-size: 0.7em;color: gray;margin-top: -5px;font-family: Calibri\">\n    lì tàu-toè si-lêh-kông-siâ̰-hue\n  </span>\n</p>\n<br>\n\n\n\n\n<p style=\"font-family:Sans-serif, Noto Sans\">\n  <span style=\"display: block;font-size: 1em\">\n    <ruby style=\"position: relative;white-space: nowrap\">大漢<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.8em\">돠한</rt></ruby> <ruby style=\"position: relative;white-space: nowrap\">了後<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.55em\">ᄅᆤˆᄋᅷˉ</rt></ruby> <ruby style=\"position: relative;white-space: nowrap\">才<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.05em\">쟣ˆ-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">知影<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.55em\">재ˉ얄`</rt></ruby> <ruby style=\"position: relative;white-space: nowrap\">阿媽<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.55em\">아ˉ마`</rt></ruby>’에 <ruby style=\"position: relative;white-space: nowrap\">話<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.25em\">웨ˉ</rt></ruby>\n  </span>\n  <span style=\"display: block;font-size: 0.7em;color: gray;margin-top: -5px;font-family: Calibri\">\n    toa-han liâu-āu jiâh-jāi-yà̰ ā-mà’e wē\n  </span>\n</p>\n\n\n<p style=\"font-family:Sans-serif, Noto Sans\">\n  <span style=\"display: block;font-size: 1em\">\n    <ruby style=\"position: relative\">꽈<rt style=\"font-size: 120%;position: absolute;top: -1.15em;left: 0.2em;z-index: -1\">ˎ</rt></ruby> 에가<ruby style=\"position: relative;white-space: nowrap\">永遠<rt style=\"font-size: 57%;position: absolute;top: -1.