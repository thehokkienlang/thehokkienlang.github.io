t: 0.2em;z-index: -1\">ˎ</rt></ruby>\n  </span>\n  <span style=\"display: block;font-size: 0.7em;color: gray;margin-top: -5px;font-family: Calibri\">\n    m-sī m-sī m-si-lì\n  </span>\n</p>\n<br>\n</div>\n</div>\n\n\n\n<table class=\"wp-block-table alignleft\" style=\"border-collapse: collapse;border: none;font-size: 14px\">\n  <tbody><tr>\n    <td style=\"border: none;vertical-align: top;min-width: 5em;padding-right: 1.5em;padding-left: 0;padding-top: 0;padding-bottom: 0\">\n  <a href=\"#_ftnref1\" id=\"_ftn1\">¹</a>\n  <i>\n    <span style=\"display: inline-flex\">\n      祝福\n    </span>\n  </i> :\n</td>\n    <td style=\"border: none;padding: 0\">\n      (中) 漢字寫為「祝福」，實際發音為「<ruby style=\"position: relative\">죠<rt style=\"font-size: 120%;position: absolute;top: -1.15em;left: 0.2em;z-index: -1\">ˍ</rt></ruby><ruby style=\"position: relative\">허<rt style=\"font-size: 120%;position: absolute;top: -1.15em;left: 0.2em;z-index: -1\">ꞈ</rt></ruby>（招呼）」。<br>\n      (en) Whilst the Hanri is written as &#8220;祝福&#8221; (to bless), the actual pronunciation of the lyrics is &#8220;<ruby style=\"position: relative\">죠<rt style=\"font-size: 120%;position: absolute;top: -1.15em;left: 0.2em;z-index: -1\">ˍ</rt></ruby><ruby style=\"position: relative\">허<rt style=\"font-size: 120%;position: absolute;top: -1.15em;left: 0.2em;z-index: -1\">ꞈ</rt></ruby> (招呼)&#8221; (to serve).\n    </td>\n  </tr>\n</tbody></table>\n\n<div style=\"clear: both;margin-bottom: 1em\"></div>\n\n\n\n<p class=\"wp-block-paragraph\"></p>\n"
