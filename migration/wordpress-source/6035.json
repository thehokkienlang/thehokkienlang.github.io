e;top: -1.2em;left: 0.4em\">암</rt></ruby>\n  </span>\n  <span style=\"display: block;font-size: 0.7em;color: gray;margin-top: -5px;font-family: Calibri\">\n    rît’si tân-kàu-rit-tháu am\n  </span>\n</p>\n\n<!-- #2 -->\n<p style='font-family:Sans-serif, Noto Sans'>\n  <span style=\"display: block;font-size: 1em\">\n    <ruby style=\"position: relative;white-space: nowrap\">為何<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.8em\">위호-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">天<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.25em\">틸ˆ</rt></ruby> <ruby style=\"position: relative;white-space: nowrap\">不<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.05em\">붇ˆ-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">從<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.4em\">졍-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">人願<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.8em\">띤꽌ˉ</rt></ruby>\n  </span>\n  <span style=\"display: block;font-size: 0.7em;color: gray;margin-top: -5px;font-family: Calibri\">\n    wi-ho-thḭ̂ pût-jiong-rin-goān\n  </span>\n</p>\n\n<!-- #3 -->\n<p style='font-family:Sans-serif, Noto Sans'>\n  <span style=\"display: block;font-size: 1em\">\n    <ruby style=\"position: relative;white-space: nowrap\">幸福<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.8em\">혱헉</rt></ruby> <ruby style=\"position: relative;white-space: nowrap\">佮<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.05em\">갛ˆ-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">悲傷<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.55em\">비ˉ셩ˆ</rt></ruby> <ruby style=\"position: relative;white-space: nowrap\">相<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.05em\">쇼ˉ-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">黏<rt style=\"font-size: 57%;position: