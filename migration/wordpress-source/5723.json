  "content": "\n<h2 class=\"wp-block-heading\"><span style=\"font-family: Sans-serif, Noto Sans\"><ruby style=\"position: relative\">쇼<rt style=\"font-size: 120%;position: absolute;top: -1.15em;left: 0.2em;z-index: -1\">ˍ</rt></ruby><ruby style=\"position: relative\">빻<rt style=\"font-size: 120%;position: absolute;top: -1.15em;left: 0.2em;z-index: -1\">ꞈ</rt></ruby>장</span></h2>\n\n\n\n<figure class=\"wp-block-embed is-type-video is-provider-youtube wp-block-embed-youtube wp-embed-aspect-4-3 wp-has-aspect-ratio\"><div class=\"wp-block-embed__wrapper\">\n<span class=\"embed-youtube\" style=\"text-align:center; display: block;\"><iframe loading=\"lazy\" class=\"youtube-player\" width=\"640\" height=\"360\" src=\"https://www.youtube.com/embed/m45fUda0xP4?version=3&#038;rel=1&#038;showsearch=0&#038;showinfo=1&#038;iv_load_policy=1&#038;fs=1&#038;hl=en&#038;autohide=2&#038;wmode=transparent\" allowfullscreen=\"true\" style=\"border:0;\" sandbox=\"allow-scripts allow-same-origin allow-popups allow-presentation allow-popups-to-escape-sandbox\"></iframe></span>\n</div></figure>\n\n\n\n<h3 class=\"wp-block-heading\">漢諺混寫 Hanri-Hangul mixed script</h3>\n\n\n\n<!-- #1 -->\n<p style=\"font-family:Sans-serif, Noto Sans\">\n  <span style=\"display: block;font-size: 1em\">\n    <ruby style=\"position: relative;white-space: nowrap\">想起<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.8em\">슐킈ˆ-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">細漢<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.55em\">쇠`한</rt></ruby> <ruby style=\"position: relative;white-space: nowrap\">真<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.05em\">진ˉ-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">活動<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.8em\">왛당ˉ</rt></ruby>\n  </span>\n  <span style=\"display: block;font-size: 0.7em;color: gray;margin-top: -5px;font-family: Calibri\">\n    siṵ-khî-soè-han jīn-oah-tāng\n  </span>\n</p>\n\n<!-- #2 -->\n<p style=\"font-family:Sans-serif, Noto Sans\">\n  <span style=\"display: block;font-size: 1em\">\n    <ruby style=\"position: relative;white-space: nowrap\">爸母<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.8em\">베뿌`</rt></ruby> <ruby style=\"position: relative;white-space: nowrap\">本來<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.55em\">분ˆ래-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">真<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.05em\">진ˉ-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">疼痛<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.55em\">턀`탕</rt></ruby>\n  </span>\n  <span style=\"display: block;font-size: 0.7em;color: gray;margin-top: -5px;font-family: Calibri\">\n    pe-bù pûn-lai-jīn-thià̰-thang\n  </span>\n</p>\n\n<!-- #3 -->\n<p style=\"font-family:Sans-serif, Noto Sans\">\n  <span style=\"display: block;font-size: 1em\">\n    허<ruby style=\"position: relative\">꽈<rt style=\"font-size: 120%;position: absolute;top: -1.15em;left: 0.2em;z-index: -1\">ˎ</rt></ruby> <ruby style=\"position: relative;white-space: nowrap\">讀書<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.8em\">탁주ˆ</rt></ruby> <ruby style=\"position: relative;white-space: nowrap\">規<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.05em\">귀ˉ-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">落<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.4em\">롷-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">冬<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.25em\">당ˆ</rt></ruby>\n  </span>\n  <span style=\"display: block;font-size: 0.7em;color: gray;margin-top: -5px;font-family: Calibri\">\n    hor-goà thak-jû kūi-loh-tâng\n  </span>\n</p>\n\n<!-- #4 -->\n<p style=\"font-family:Sans-serif, Noto Sans\">\n  <span style=\"display: block;font-size: 1em\">\n    <ruby style=\"position: relative;white-space: nowrap\">出業<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.55em\">춛ˆ꺕ˆ</rt></ruby> <ruby style=\"position: relative;white-space: nowrap\">頭路<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.8em\">ᄐᅷ러ˉ</rt></ruby> 뽀<ruby style=\"position: relative;white-space: nowrap\">半<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.05em\">봘`-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">項<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.25em\">항ˉ</rt></ruby>\n  </span>\n  <span style=\"display: block;font-size: 0.7em;color: gray;margin-top: -5px;font-family: Calibri\">\n    chût-giâp thau-lōr bo-poà̰-hāng\n  </span>\n</p>\n\n<!-- #5 -->\n<p style=\"font-family:Sans-serif, Noto Sans\">\n  <span style=\"display: block;font-size: 1em\">\n    <ruby style=\"position: relative;white-space: nowrap\">暫時<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.8em\">쟘시ˊ</rt></ruby> <ruby style=\"position: relative;white-space: nowrap\">來<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.4em\">래-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">賣<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.4em\">뾔-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">燒肉粽<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.8em\">쇼ˉ빻ˆ장</rt></ruby>\n  </span>\n  <span style=\"display: block;font-size: 0.7em;color: gray;margin-top: -5px;font-family: Calibri\">\n    jiam-sí lai-boe-siō-bâh-jang\n  </span>\n</p>\n<br>\n\n\n\n<!-- #1 -->\n<p style=\"font-family:Sans-serif, Noto Sans\">\n  <span style=\"display: block;font-size: 1em\">\n    <ruby style=\"position: relative;white-space: nowrap\">燒肉粽<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.8em\">쇼ˉ빻ˆ장</rt></ruby> <ruby style=\"position: relative;white-space: nowrap\">燒肉粽<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.8em\">쇼ˉ빻ˆ장</rt></ruby>\n  </span>\n  <span style=\"display: block;font-size: 0.7em;color: gray;margin-top: -5px;font-family: Calibri\">\n    siō-bâh-jang siō-bâh-jang\n  </span>\n</p>\n\n<!-- #2 -->\n<p style=\"font-family:Sans-serif, Noto Sans\">\n  <span style=\"display: block;font-size: 1em\">\n    <ruby style=\"position: relative;white-space: nowrap\">賣<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.4em\">뾔-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">燒肉粽<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.8em\">쇼ˉ빻ˆ장</rt></ruby>\n  </span>\n  <span style=\"display: block;font-size: 0.7em;color: gray;margin-top: -5px;font-family: Calibri\">\n    boe-siō-bâh-jang\n  </span>\n</p>\n<br>\n\n\n\n<!-- #1 -->\n<p style=\"font-family:Sans-serif, Noto Sans\">\n  <span style=\"display: block;font-size: 1em\">\n    <ruby style=\"position: relative;white-space: nowrap\">欲<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.05em\">뼇ˆ-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">做<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.05em\">죄`-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">生理<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.55em\">솅ˉ리`</rt></ruby> <ruby style=\"position: relative;white-space: nowrap\">真<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.05em\">진ˉ-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">困難<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.55em\">쿤`란ˊ</rt></ruby>\n  </span>\n  <span style=\"display: block;font-size: 0.7em;color: gray;margin-top: -5px;font-family: Calibri\">\n    bêh-joè-siēng-lì jīn-khùn-lán\n  </span>\n</p>\n\n<!-- #2 -->\n<p style=\"font-family:Sans-serif, Noto Sans\">\n  <span style=\"display: block;font-size: 1em\">\n    <ruby style=\"position: relative;white-space: nowrap\">若<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.4em\">나</rt></ruby>뽀<ruby style=\"position: relative;white-space: nowrap\">本錢<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.55em\">분ˆ질ˊ</rt></ruby> <ruby style=\"position: relative;white-space: nowrap\">做<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.05em\">죄`-</rt></ruby>뾔<ruby style=\"position: relative;white-space: nowrap\">動<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.25em\">당ˉ</rt></ruby>\n  </span>\n  <span style=\"display: block;font-size: 0.7em;color: gray;margin-top: -5px;font-family: Calibri\">\n    na-bo-pûn-jḭ́ joè-boe-tāng\n  </span>\n</p>\n\n<!-- #3 -->\n<p style=\"font-family:Sans-serif, Noto Sans\">\n  <span style=\"display: block;font-size: 1em\">\n    <ruby style=\"position: relative;white-space: nowrap\">不正<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.55em\">붇ˆ졩`-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">行為<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.8em\">혱위ˊ</rt></ruby> <ruby style=\"position: relative;white-space: nowrap\">是<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.4em\">시-</rt></ruby>음<ruby style=\"position: relative;white-space: nowrap\">通<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.25em\">탕ˆ</rt></ruby>\n  </span>\n  <span style=\"display: block;font-size: 0.7em;color: gray;margin-top: -5px;font-family: Calibri\">\n    pût-jièng-hieng-wí si-m-thâng\n  </span>\n</p>\n\n<!-- #4 -->\n<p style=\"font-family:Sans-serif, Noto Sans\">\n  <span style=\"display: block;font-size: 1em\">\n    <ruby style=\"position: relative;white-space: nowrap\">所以<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.55em\">서ˆ이ˆ-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">暫時<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.8em\">쟘시ˊ</rt></ruby> <ruby style=\"position: relative;white-space: nowrap\">做<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.05em\">죄`-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\" title=\"jît\">這<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.05em\">짇ˆ-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">項<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.25em\">항ˉ</rt></ruby>\n  </span>\n  <span style=\"display: block;font-size: 0.7em;color: gray;margin-top: -5px;font-family: Calibri\">\n    sôr-î-jiam-sí joè-jît-hāng\n  </span>\n</p>\n\n<!-- #5 -->\n<p style=\"font-family:Sans-serif, Noto Sans\">\n  <span style=\"display: block;font-size: 1em\">\n    <ruby style=\"position: relative;white-space: nowrap\">環境<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.8em\">환곙`</rt></ruby> <ruby style=\"position: relative;white-space: nowrap\">逼<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.05em\">볙ˆ-</rt></ruby><ruby style=\"position: relative\">꽈<rt style=\"font-size: 120%;position: absolute;top: -1.15em;left: 0.2em;z-index: -1\">ˎ</rt></ruby> <ruby style=\"position: relative;white-space: nowrap\">賣<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.4em\">뾔-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">肉粽<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.55em\">빻ˆ장</rt></ruby>\n  </span>\n  <span style=\"display: block;font-size: 0.7em;color: gray;margin-top: -5px;font-family: Calibri\">\n    hoan-kièng piêk-goà boe-bâh-jang\n  </span>\n</p>\n<br>\n\n\n\n<!-- #1 -->\n<p style='font-family:Sans-serif, Noto Sans'>\n  <span style=\"display: block;font-size: 1em\">\n    <ruby style=\"position: relative;white-space: nowrap\">燒肉粽<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.8em\">쇼ˉ빻ˆ장</rt></ruby> <ruby style=\"position: relative;white-space: nowrap\">燒肉粽<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.8em\">쇼ˉ빻ˆ장</rt></ruby>\n  </span>\n  <span style=\"display: block;font-size: 0.7em;color: gray;margin-top: -5px;font-family: Calibri\">\n    siō-bâh-jang siō-bâh-jang\n  </span>\n</p>\n\n<!-- #2 -->\n<p style='font-family:Sans-serif, Noto Sans'>\n  <span style=\"display: block;font-size: 1em\">\n    <ruby style=\"position: relative;white-space: nowrap\">賣<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.4em\">뾔-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">燒肉粽<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.8em\">쇼ˉ빻ˆ장</rt></ruby>\n  </span>\n  <span style=\"display: block;font-size: 0.7em;color: gray;margin-top: -5px;font-family: Calibri\">\n    boe-siō-bâh-jang\n  </span>\n</p>\n<br>\n\n\n\n<!-- #1 -->\n<p style=\"font-family:Sans-serif, Noto Sans\">\n  <span style=\"display: block;font-size: 1em\">\n    <ruby style=\"position: relative;white-space: nowrap\">物件<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.8em\">밓걀ˉ</rt></ruby> <ruby style=\"position: relative;white-space: nowrap\">一日<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.8em\">짇띧-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">一日<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.8em\">짇띧ˆ</rt></ruby> <ruby style=\"position: relative;white-space: nowrap\">貴<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.4em\">귀</rt></ruby>\n  </span>\n  <span style=\"display: block;font-size: 0.7em;color: gray;margin-top: -5px;font-family: Calibri\">\n    mih-kiā̰ jit-rit-jit-rît kui\n  </span>\n</p>\n\n<!-- #2 -->\n<p style=\"font-family:Sans-serif, Noto Sans\">\n  <span style=\"display: block;font-size: 1em\">\n    <ruby style=\"position: relative;white-space: nowrap\">厝內<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.55em\">추`래ˉ</rt></ruby> <ruby style=\"position: relative;white-space: nowrap\">頭喙<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.8em\">ᄐᅷ취</rt></ruby> <ruby style=\"position: relative;white-space: nowrap\" title=\"jiâh\">遮<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.05em\">쟣ˆ-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">大堆<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.8em\">돠뒤ˆ</rt></ruby>\n  </span>\n  <span style=\"display: block;font-size: 0.7em;color: gray;margin-top: -5px;font-family: Calibri\">\n    chù-lāi thau-chui jiâh-toa-tûi\n  </span>\n</p>\n\n<!-- #3 -->\n<p style=\"font-family:Sans-serif, Noto Sans\">\n  <span style=\"display: block;font-size: 1em\">\n    <ruby style=\"position: relative;white-space: nowrap\">雙跤<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.55em\">샹ˉ카ˆ</rt></ruby> <ruby style=\"position: relative;white-space: nowrap\">走<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.05em\">ᄌᅷˆ-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">到<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.05em\">ᄀᅷ`-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">欲<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.05em\">뼇ˆ-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">牚腿<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.55em\">틸`튀`</rt></ruby>\n  </span>\n  <span style=\"display: block;font-size: 0.7em;color: gray;margin-top: -5px;font-family: Calibri\">\n    siāng-khâ jâu-kàu-bêh-thḭ̀-thùi\n  </span>\n</p>\n\n<!-- #4 -->\n<p style=\"font-family:Sans-serif, Noto Sans\">\n  <span style=\"display: block;font-size: 1em\">\n    <ruby style=\"position: relative;white-space: nowrap\">拄<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.05em\">두ˆ-</rt></ruby>둏뽀<ruby style=\"position: relative;white-space: nowrap\">銷<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.25em\">ᄉᆤˆ</rt></ruby> <ruby style=\"position: relative;white-space: nowrap\">上<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.4em\">셩-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">克虧<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.55em\">켹ˆ퀴ˆ</rt></ruby>\n  </span>\n  <span style=\"display: block;font-size: 0.7em;color: gray;margin-top: -5px;font-family: Calibri\">\n    tû-tioh-bo-siâu siong-khiêk-khûi\n  </span>\n</p>\n\n<!-- #5 -->\n<p style=\"font-family:Sans-serif, Noto Sans\">\n  <span style=\"display: block;font-size: 1em\">\n    <ruby style=\"position: relative;white-space: nowrap\">認真<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.8em\">띤진ˉ-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">來<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.4em\">래-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">賣<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.4em\">뾔-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">燒肉粽<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.8em\">쇼ˉ빻ˆ장</rt></ruby>\n  </span>\n  <span style=\"display: block;font-size: 0.7em;color: gray;margin-top: -5px;font-family: Calibri\">\n    rin-jīn-lai-boe-siō-bâh-jang\n  </span>\n</p>\n<br>\n\n\n\n<!-- #1 -->\n<p style='font-family:Sans-serif, Noto Sans'>\n  <span style=\"display: block;font-size: 1em\">\n    <ruby style=\"position: relative;white-space: nowrap\">燒肉粽<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.8em\">쇼ˉ빻ˆ장</rt></ruby> <ruby style=\"position: relative;white-space: nowrap\">燒肉粽<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.8em\">쇼ˉ빻ˆ장</rt></ruby>\n  </span>\n  <span style=\"display: block;font-size: 0.7em;color: gray;margin-top: -5px;font-family: Calibri\">\n    siō-bâh-jang siō-bâh-jang\n  </span>\n</p>\n\n<!-- #2 -->\n<p style='font-family:Sans-serif, Noto Sans'>\n  <span style=\"display: block;font-size: 1em\">\n    <ruby style=\"position: relative;white-space: nowrap\">賣<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.4em\">뾔-</rt></ruby><ruby style=\"position: relative;white-space: nowrap\">燒肉粽<rt style=\"font-size: 57%;position: absolute;top: -1.2em;left: 0.8em\">쇼ˉ빻ˆ장</rt></ruby>\n  </span>\n  <span style=\"display: block;font-size: 0.7em;color: gray;margin-top: -5px;font-family: Calibri\">\n    boe-siō-bâh-jang\n  </span>\n</p>\n<br>\n"
